# Example cluster network values for a Cluster API / self-hosted provisioning.
# Copy to `values.env` (git-ignored) and replace every range with values that fit
# YOUR network. The four ranges MUST NOT overlap.
#
# These are ILLUSTRATIVE placeholders in the documentation range (192.0.2.0/24,
# RFC 5737) — do not use them as-is.

CLUSTER_NAME=goose-demo
KUBERNETES_VERSION=v1.30.0

# Control-plane virtual IP (single address).
CONTROL_PLANE_VIP=192.0.2.10

# Worker node pool range.
WORKER_POOL_START=192.0.2.20
WORKER_POOL_END=192.0.2.39

# Load-balancer address pool (e.g. MetalLB). Must be large enough for your
# Services; keep it disjoint from the worker pool and the DHCP reserve.
METALLB_POOL_START=192.0.2.40
METALLB_POOL_END=192.0.2.59

# DHCP reserve (addresses your DHCP server hands out; keep clear of the above).
DHCP_RESERVE_START=192.0.2.100
DHCP_RESERVE_END=192.0.2.199
