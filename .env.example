# ─────────────────────────────────────────────────────────────────────────────
# Goose observability tutorial — configuration
#
# Copy this file to `.env` and fill in YOUR values, then `source .env` (or let
# the scripts/ load it automatically). Nothing here is secret until you fill it
# in, and `.env` is git-ignored so your real values never get committed.
# ─────────────────────────────────────────────────────────────────────────────

# --- Kubernetes -------------------------------------------------------------
# Namespace everything is deployed into.
NAMESPACE=goose

# --- LLM provider (Ollama) --------------------------------------------------
# Goose runs any LLM. This tutorial uses a local Ollama host so nothing leaves
# your network. Point this at YOUR Ollama server — a Mac Studio, a workstation
# with a GPU, or a dedicated inference box. Use an IP/hostname reachable from
# inside the cluster (not "localhost", which resolves to the pod itself).
OLLAMA_BASE_URL=http://your-ollama-host:11434
OLLAMA_MODEL=qwen2.5:14b

# --- Dynatrace --------------------------------------------------------------
# Your Dynatrace environment. For SaaS this looks like:
#   https://abc12345.live.dynatrace.com
DT_ENVIRONMENT_URL=https://YOUR_TENANT.live.dynatrace.com

# API token used by the Dynatrace Operator / DynaKube (kubernetes-monitoring,
# routing, dynatrace-api). Needs the standard Operator scopes.
DT_API_TOKEN=dt0c01.CHANGE_ME

# Data-ingest token used by the OTLP exporters (metrics-ingest + logs/traces
# via OTLP). Needs: openTelemetryTrace.ingest, metrics.ingest, logs.ingest.
DT_INGEST_TOKEN=dt0c01.CHANGE_ME

# --- OpenTelemetry collector ------------------------------------------------
# The in-cluster gateway Service that Goose exports to. Goose speaks OTLP/HTTP
# ONLY — this MUST be the :4318 (HTTP) endpoint, never :4317 (gRPC).
OTEL_COLLECTOR_ENDPOINT=http://otel-gateway-collector.goose.svc.cluster.local:4318
OTEL_SERVICE_NAME=goose

# --- MCP credentials --------------------------------------------------------
# GitHub token for the GitHub MCP extension (repo scope for the demo).
GITHUB_TOKEN=ghp_CHANGE_ME

# Dynatrace token for the Dynatrace MCP extension (read scopes: problems,
# metrics query, entities). Can be the same as DT_API_TOKEN if it carries the
# read scopes, but a dedicated read-only token is cleaner.
DT_MCP_TOKEN=dt0c01.CHANGE_ME
